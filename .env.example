# ============================================================
# Forger configuration — copy to .env and fill in ONE
# LLM provider block. Everything else is optional.
# ============================================================

# --- LLM provider (pick one) --------------------------------
# Option A: DeepSeek (default)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Option B: Kimi
# ANALYSIS_PROVIDER=kimi
# KIMI_API_KEY=

# Option C: any OpenAI-compatible API (GLM, OpenAI, Ollama, ...)
# ANALYSIS_PROVIDER=custom
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=
# LLM_MODEL=glm-4.7

# --- Personalization ----------------------------------------
# profile.md drives ALL relevance scoring. Default: ./profile.md
# FORGER_PROFILE=/absolute/path/to/profile.md
# Optional: a folder of .md notes searched for extra context per bookmark
# FORGER_EXTRA_CONTEXT_DIR=

# --- X/Twitter scraping (optional) ---------------------------
# X blocks anonymous scraping; export cookies from a logged-in
# browser session into one JSON file to enable X links.
# X_COOKIES_PATH=./data/x_cookies.json
