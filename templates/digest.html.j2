{# Weekly Digest Template - HTML Version #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weekly Digest - {{ week_range }}</title>
    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --bg-tertiary: #334155;
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --accent-green: #22c55e;
            --accent-orange: #f97316;
            --accent-blue: #3b82f6;
            --accent-purple: #a855f7;
            --border: #334155;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            padding: 20px;
        }
        
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        
        header {
            text-align: center;
            padding: 40px 0;
            border-bottom: 1px solid var(--border);
            margin-bottom: 40px;
        }
        
        h1 {
            font-size: 2.5rem;
            margin-bottom: 8px;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .week-range {
            color: var(--text-secondary);
            font-size: 1.1rem;
        }
        
        .generated {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-top: 8px;
        }
        
        .insights {
            background: var(--bg-secondary);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 32px;
            border-left: 4px solid var(--accent-blue);
        }
        
        .insights h2 {
            font-size: 1.2rem;
            margin-bottom: 16px;
            color: var(--accent-blue);
        }
        
        .insights ul {
            list-style: none;
        }
        
        .insights li {
            padding: 8px 0;
            border-bottom: 1px solid var(--border);
        }
        
        .insights li:last-child {
            border-bottom: none;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
        }
        
        .stat-card {
            background: var(--bg-secondary);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
        }
        
        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 4px;
        }
        
        .stat-label {
            color: var(--text-secondary);
            font-size: 0.875rem;
        }
        
        .stat-card.total .stat-value { color: var(--text-primary); }
        .stat-card.test .stat-value { color: var(--accent-green); }
        .stat-card.build .stat-value { color: var(--accent-orange); }
        .stat-card.archive .stat-value { color: var(--text-secondary); }
        
        .section {
            margin-bottom: 40px;
        }
        
        .section-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }
        
        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
        }
        
        .section-count {
            background: var(--bg-tertiary);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.875rem;
            color: var(--text-secondary);
        }
        
        .bookmark-card {
            background: var(--bg-secondary);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 16px;
            border: 1px solid var(--border);
            transition: border-color 0.2s;
        }
        
        .bookmark-card:hover {
            border-color: var(--accent-blue);
        }
        
        .bookmark-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
            gap: 16px;
        }
        
        .bookmark-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
            text-decoration: none;
            line-height: 1.4;
        }
        
        .bookmark-title:hover {
            color: var(--accent-blue);
        }
        
        .bookmark-meta {
            display: flex;
            gap: 16px;
            color: var(--text-secondary);
            font-size: 0.875rem;
            margin-bottom: 12px;
        }
        
        .bookmark-summary {
            color: var(--text-secondary);
            margin-bottom: 16px;
            line-height: 1.6;
        }
        
        .scores {
            display: flex;
            gap: 16px;
            margin-bottom: 16px;
        }
        
        .score {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.875rem;
        }
        
        .score-label {
            color: var(--text-secondary);
        }
        
        .score-value {
            font-weight: 600;
        }
        
        .score-high { color: var(--accent-green); }
        .score-medium { color: var(--accent-orange); }
        .score-low { color: var(--text-secondary); }
        
        .actions {
            background: var(--bg-primary);
            border-radius: 8px;
            padding: 12px 16px;
        }
        
        .actions-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }
        
        .actions-list {
            list-style: none;
        }
        
        .actions-list li {
            padding: 4px 0;
            padding-left: 16px;
            position: relative;
            font-size: 0.9rem;
        }
        
        .actions-list li::before {
            content: "→";
            position: absolute;
            left: 0;
            color: var(--accent-green);
        }
        
        .trends {
            background: var(--bg-secondary);
            border-radius: 12px;
            padding: 24px;
        }
        
        .trends h2 {
            margin-bottom: 20px;
        }
        
        .trend-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }
        
        .trend-item {
            background: var(--bg-primary);
            border-radius: 8px;
            padding: 16px;
        }
        
        .trend-item h3 {
            font-size: 0.875rem;
            color: var(--text-secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
        }
        
        .trend-value {
            font-size: 1.5rem;
            font-weight: 600;
        }
        
        .trend-up { color: var(--accent-green); }
        .trend-down { color: #ef4444; }
        .trend-stable { color: var(--text-secondary); }
        
        .topics-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
        }
        
        .topic-tag {
            background: var(--bg-tertiary);
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 0.875rem;
        }
        
        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-secondary);
            background: var(--bg-secondary);
            border-radius: 12px;
        }
        
        footer {
            text-align: center;
            padding: 40px 0;
            color: var(--text-secondary);
            border-top: 1px solid var(--border);
            margin-top: 40px;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>📚 Weekly Digest</h1>
            <div class="week-range">{{ week_range }}</div>
            <div class="generated">Generated on {{ generated_at }}</div>
        </header>
        
        {% if insights %}
        <div class="insights">
            <h2>💡 Key Insights</h2>
            <ul>
                {% for insight in insights %}
                <li>{{ insight }}</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        
        <div class="stats-grid">
            <div class="stat-card total">
                <div class="stat-value">{{ stats.total_new }}</div>
                <div class="stat-label">New Bookmarks</div>
            </div>
            <div class="stat-card test">
                <div class="stat-value">{{ stats.test_this_week }}</div>
                <div class="stat-label">Test This Week</div>
            </div>
            <div class="stat-card build">
                <div class="stat-value">{{ stats.build_later }}</div>
                <div class="stat-label">Build Later</div>
            </div>
            <div class="stat-card archive">
                <div class="stat-value">{{ stats.archive }}</div>
                <div class="stat-label">Archive</div>
            </div>
        </div>
        
        {% if test_this_week %}
        <section class="section">
            <div class="section-header">
                <h2 class="section-title">⚡ Test This Week</h2>
                <span class="section-count">{{ test_this_week|length }} items</span>
            </div>
            {% for item in test_this_week %}
            <div class="bookmark-card">
                <div class="bookmark-header">
                    <a href="{{ item.bookmark.url }}" class="bookmark-title" target="_blank">
                        {{ item.bookmark.title or item.bookmark.text[:80] + "..." }}
                    </a>
                </div>
                <div class="bookmark-meta">
                    <span>{{ item.bookmark.source }}</span>
                    {% if item.bookmark.author %}
                    <span>@{{ item.bookmark.author }}</span>
                    {% endif %}
                </div>
                <div class="bookmark-summary">{{ item.analysis.summary }}</div>
                <div class="scores">
                    <div class="score">
                        <span class="score-label">Worth:</span>
                        <span class="score-value {% if item.analysis.worth_score >= 8 %}score-high{% elif item.analysis.worth_score >= 5 %}score-medium{% else %}score-low{% endif %}">
                            {{ "%.1f"|format(item.analysis.worth_score) }}
                        </span>
                    </div>
                    <div class="score">
                        <span class="score-label">Priority:</span>
                        <span class="score-value {% if item.analysis.priority_score >= 7 %}score-high{% elif item.analysis.priority_score >= 4 %}score-medium{% else %}score-low{% endif %}">
                            {{ "%.1f"|format(item.analysis.priority_score) }}
                        </span>
                    </div>
                </div>
                {% if item.action_items %}
                <div class="actions">
                    <div class="actions-title">Suggested Actions</div>
                    <ul class="actions-list">
                        {% for action in item.action_items %}
                        <li>{{ action }}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </section>
        {% endif %}
        
        {% if build_later %}
        <section class="section">
            <div class="section-header">
                <h2 class="section-title">📚 Build Later</h2>
                <span class="section-count">{{ build_later|length }} items</span>
            </div>
            {% for item in build_later[:5] %}
            <div class="bookmark-card">
                <div class="bookmark-header">
                    <a href="{{ item.bookmark.url }}" class="bookmark-title" target="_blank">
                        {{ item.bookmark.title or item.bookmark.text[:80] + "..." }}
                    </a>
                </div>
                <div class="bookmark-summary">{{ item.analysis.summary[:150] }}{% if item.analysis.summary|length > 150 %}...{% endif %}</div>
                <div class="scores">
                    <div class="score">
                        <span class="score-label">Worth:</span>
                        <span class="score-value">{{ "%.1f"|format(item.analysis.worth_score) }}</span>
                    </div>
                </div>
            </div>
            {% endfor %}
            {% if build_later|length > 5 %}
            <div class="empty-state">
                ... and {{ build_later|length - 5 }} more in build later
            </div>
            {% endif %}
        </section>
        {% endif %}
        
        {% if trends.topic_distribution %}
        <div class="trends">
            <h2>📊 Trends & Patterns</h2>
            <div class="trend-grid">
                <div class="trend-item">
                    <h3>Quality Trend</h3>
                    <div class="trend-value {% if trends.quality_trend == 'up' %}trend-up{% elif trends.quality_trend == 'down' %}trend-down{% else %}trend-stable{% endif %}">
                        {{ "%.1f"|format(trends.avg_current_week_score) }}
                        {% if trends.quality_delta > 0 %}
                        <span style="font-size: 0.8rem;">(+{{ "%.2f"|format(trends.quality_delta) }})</span>
                        {% elif trends.quality_delta < 0 %}
                        <span style="font-size: 0.8rem;">({{ "%.2f"|format(trends.quality_delta) }})</span>
                        {% endif %}
                    </div>
                </div>
                <div class="trend-item" style="grid-column: span 2;">
                    <h3>Top Topics</h3>
                    <div class="topics-list">
                        {% for topic, data in trends.topic_distribution.items() %}
                        <span class="topic-tag">{{ topic }} ({{ data.count }})</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        
        <footer>
            <p>RolloForge Weekly Digest • {{ week_range }}</p>
        </footer>
    </div>
</body>
</html>
